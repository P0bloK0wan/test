{
  "name": "netflix-web-independent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent open-cinema catalogue inspired by static APK observations",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test --test-isolation=none tests/library.test.mjs tests/server.test.mjs tests/drive-link.test.mjs tests/metadata-handler.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build-cloud.mjs",
    "test:admin": "node tests/admin-browser.mjs",
    "test:security": "node --use-env-proxy --test tests/schema.test.mjs",
    "test:metadata": "node tests/metadata-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "tus-js-client": "4.3.1"
  }
}
